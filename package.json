{
  "name": "concord",
  "private": true,
  "license": "MIT",
  "description": "Reconciliation between tokenized securities on Stellar and the official register.",
  "engines": {
    "node": ">=24",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@10.22.0",
  "scripts": {
    "build": "node init && pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "dev": "node init && pnpm --parallel --filter @concord/api --filter @concord/web dev",
    "start": "node init && pnpm --filter @concord/api start",
    "concord": "pnpm --silent --filter @concord/api cli",
    "demo:testnet": "pnpm --filter @concord/api demo:testnet"
  },
  "devDependencies": {
    "dotenv": "^8.2.0",
    "node-fetch": "^3.3.2",
    "typescript": "^5.7.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
